# Heavy 3D assets — keep tracked but off the regular git object
# store. These are needed for the LiDAR sim to run, so they can't
# just be .gitignored; LFS is the right home.
*.stl filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text

# Media. ``.gitignore`` blocks new commits of these, but if any
# media is ever intentionally tracked (e.g. a single small demo
# clip in the README), route it through LFS so it doesn't bloat
# clone for everyone else.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
